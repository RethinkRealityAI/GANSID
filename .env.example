# Copy to .env.local for development. Never commit real values.

# Site address (used for live preview and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# GANSID Supabase project (shared with the Congress app). Publishable values only.
NEXT_PUBLIC_SUPABASE_URL=https://gticuvgclbvhwvpzkuez.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection for the CMS (Supabase → Project settings → Database → Connection string,
# "Transaction pooler", port 6543). SECRET: set in Netlify env, not in git.
DATABASE_URI=

# Long random string that signs CMS sessions and previews. SECRET.
PAYLOAD_SECRET=

# Comma-separated emails that become super admins on first sign-in.
ADMIN_BOOTSTRAP_EMAILS=

# Development only: let Payload create/alter tables automatically. Never "true" in production.
PAYLOAD_DB_PUSH=false
